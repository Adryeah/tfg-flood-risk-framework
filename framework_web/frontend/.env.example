# ─── Frontend env vars ───────────────────────────────────────────
# Copia este fichero a .env.local (gitignored) y rellena lo que
# quieras sobreescribir. Todo lo que empieza por VITE_ se inlinea en
# el bundle del cliente, así que NO pongas secretos sensibles.

# Backend FastAPI. En dev usar el proxy de Vite (vacío); en producción
# Vercel apuntar al servicio Render.
VITE_API_BASE_URL=

# ─── /tour · CesiumJS ────────────────────────────────────────────
#
# El componente /tour usa CesiumJS para renderizar edificios 3D.
# Por defecto utiliza:
#   - Cesium World Terrain (fotométrico)
#   - Cesium OSM Buildings (extrusiones OSM con shading nativo)
# El token público integrado en Cesium basta para esta configuración
# (con cuota generosa para demos).
#
# Para subir a "Hollywood-grade" con Google Photorealistic 3D Tiles
# (los edificios fotogramétricos REALES de Valencia, los mismos que
# usa Google Earth Studio):
#   1. Crear cuenta gratis en https://ion.cesium.com
#   2. En Asset Depot añadir "Google Photorealistic 3D Tiles" (id 2275207)
#   3. Generar un token con permiso para ese asset
#   4. Pegarlo abajo + poner VITE_USE_GOOGLE_3D_TILES=true
# Free tier de Cesium ion: 5 GB/mes de transferencia, sobrado para
# defender el TFG.

VITE_CESIUM_ION_TOKEN=
VITE_USE_GOOGLE_3D_TILES=false
